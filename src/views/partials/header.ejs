<header class="navbar">
  <div class="container">
    <a class="brand" href="/contactos">📇 Contactos</a>

    <nav class="nav-links">
      <a href="/contactos">Inicio</a>

      <% if (usuario) { %>
        <a href="/contactos/nuevo">Nuevo contacto</a>
        <span class="nav-user">Hola, <%= usuario.nombre %></span>
        <form class="inline" method="POST" action="/logout">
          <button type="submit" class="btn btn-outline btn-sm">Salir</button>
        </form>
      <% } else { %>
        <a href="/login">Entrar</a>
        <a href="/registro" class="btn btn-outline btn-sm">Registrarse</a>
      <% } %>
    </nav>
  </div>
</header>