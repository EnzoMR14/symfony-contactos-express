<div class="auth">
  <h1>Iniciar sesión</h1>

  <% if (errorLogin) { %><p class="alert"><%= errorLogin %></p><% } %>

  <form class="card" method="POST" action="/login" novalidate>
    <div>
      <label for="email">Email</label>
      <input type="email" id="email" name="email" value="<%= datos.email || '' %>" required>
      <% if (errores.email) { %><p class="error"><%= errores.email.msg %></p><% } %>
    </div>

    <div>
      <label for="password">Contraseña</label>
      <input type="password" id="password" name="password" required>
      <% if (errores.password) { %><p class="error"><%= errores.password.msg %></p><% } %>
    </div>

    <button type="submit" class="btn btn-primary">Entrar</button>
  </form>

  <p class="auth-note">¿No tienes cuenta? <a href="/registro">Regístrate</a></p>
</div>