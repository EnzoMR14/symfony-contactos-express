<h1><%= titulo %></h1>

<form method="POST" action="<%= accion %>" novalidate>
  <div>
    <label for="nombre">Nombre</label>
    <input type="text" id="nombre" name="nombre" value="<%= datos.nombre || '' %>" required>
    <% if (errores.nombre) { %><p class="error"><%= errores.nombre.msg %></p><% } %>
  </div>

  <div>
    <label for="telefono">Teléfono</label>
    <input type="text" id="telefono" name="telefono" value="<%= datos.telefono || '' %>" required>
    <% if (errores.telefono) { %><p class="error"><%= errores.telefono.msg %></p><% } %>
  </div>

  <div>
    <label for="email">Correo electrónico</label>
    <input type="email" id="email" name="email" value="<%= datos.email || '' %>" required>
    <% if (errores.email) { %><p class="error"><%= errores.email.msg %></p><% } %>
  </div>

  <div>
    <label for="provinciaId">Provincia</label>
    <select id="provinciaId" name="provinciaId">
      <option value="">-- Sin provincia --</option>
      <% provincias.forEach(p => { %>
        <option value="<%= p.id %>" <%= String(datos.provinciaId) === String(p.id) ? 'selected' : '' %>>
          <%= p.nombre %>
        </option>
      <% }) %>
    </select>
    <% if (errores.provinciaId) { %><p class="error"><%= errores.provinciaId.msg %></p><% } %>
  </div>

  <button type="submit">Guardar</button>
  <a href="/contactos">Cancelar</a>
</form>