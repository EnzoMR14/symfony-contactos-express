<div class="page-head">
  <h1>Listado de contactos</h1>
  <% if (usuario) { %>
    <a class="btn btn-primary" href="/contactos/nuevo">+ Nuevo contacto</a>
  <% } %>
</div>

<% if (contactos.length === 0) { %>
  <div class="card empty">
    <p>Todavía no hay contactos.</p>
  </div>
<% } else { %>
  <div class="card table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Nombre</th>
          <th>Teléfono</th>
          <th>Email</th>
          <th>Provincia</th>
          <th>País</th>
        </tr>
      </thead>
      <tbody>
        <% contactos.forEach(c => { %>
          <tr class="fila-click" data-href="<%= usuario ? '/contactos/' + c.id + '/editar' : '/contactos/' + c.id %>">
            <td><a href="/contactos/<%= c.id %>"><%= c.nombre %></a></td>
            <td><%= c.telefono %></td>
            <td><%= c.email %></td>
            <td>
              <% if (c.provincia) { %>
                <span class="badge"><%= c.provincia.nombre %></span>
              <% } else { %>
                <span class="badge badge-muted">Sin provincia</span>
              <% } %>
            </td>
            <td>
              <% if (c.pais) { %>
                <span class="badge"><%= c.pais.nombre %></span>
              <% } else { %>
                <span class="badge badge-muted">Sin país</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<script>
  document.querySelectorAll('tr[data-href]').forEach((fila) => {
    fila.addEventListener('click', (e) => {
      if (e.target.closest('a')) return; // el enlace del nombre sigue yendo a la ficha
      window.location.href = fila.dataset.href;
    });
  });
</script>