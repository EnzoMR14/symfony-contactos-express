<h1>Listado de contactos</h1>
<% if (usuario) { %>
<p><a href="/contactos/nuevo">+ Nuevo contacto</a></p>
<% } %>
<ul>
  <% contactos.forEach(c => { %>
    <li>
      <a href="/contactos/<%= c.id %>"><%= c.nombre %></a>
      - <%= c.telefono %> - <%= c.email %>
      - <%= c.provincia ? c.provincia.nombre : 'Sin provincia' %>
    </li>
  <% }) %>
</ul>