const bcrypt = require('bcrypt');
const { validationResult } = require('express-validator');
const { Usuario } = require('../models');

// Guarda al usuario en la sesión (regenerar el id evita ataques de "session fixation")
function iniciarSesion(req, res, next, usuario) {
  req.session.regenerate((err) => {
    if (err) return next(err);
    req.session.usuario = { id: usuario.id, nombre: usuario.nombre, rol: usuario.rol };
    req.session.save((err2) => {
      if (err2) return next(err2);
      res.redirect('/contactos');
    });
  });
}

exports.formRegistro = (req, res) => {
  res.render('auth/registro', { titulo: 'Registro', datos: {}, errores: {} });
};

exports.registro = async (req, res, next) => {
  const errors = validationResult(req);
  if (!errors.isEmpty()) {
    return res.status(422).render('auth/registro', {
      titulo: 'Registro', datos: req.body, errores: errors.mapped(),
    });
  }

  const { nombre, email, password } = req.body;
  const hash = await bcrypt.hash(password, 10);
  const usuario = await Usuario.create({ nombre, email, password: hash });

  // Como en Symfony: tras registrarse, queda autenticado
  iniciarSesion(req, res, next, usuario);
};

exports.formLogin = (req, res) => {
  res.render('auth/login', { titulo: 'Iniciar sesión', datos: {}, errores: {}, errorLogin: null });
};

exports.login = async (req, res, next) => {
  const errors = validationResult(req);
  if (!errors.isEmpty()) {
    return res.status(422).render('auth/login', {
      titulo: 'Iniciar sesión', datos: req.body, errores: errors.mapped(), errorLogin: null,
    });
  }

  const { email, password } = req.body;
  const usuario = await Usuario.findOne({ where: { email } });
  const correcto = usuario && await bcrypt.compare(password, usuario.password);

  if (!correcto) {
    // Mensaje genérico: no revela si el email existe
    return res.status(401).render('auth/login', {
      titulo: 'Iniciar sesión', datos: req.body, errores: {}, errorLogin: 'Credenciales incorrectas',
    });
  }

  iniciarSesion(req, res, next, usuario);
};

exports.logout = (req, res, next) => {
  req.session.destroy((err) => {
    if (err) return next(err);
    res.clearCookie('connect.sid');
    res.redirect('/login');
  });
};