const { Contacto, Provincia, Pais } = require('../models');
const { validationResult } = require('express-validator');

const incluir = [
  { model: Provincia, as: 'provincia' },
  { model: Pais, as: 'pais' },
];

// Datos para los desplegables del formulario
async function cargarListas() {
  const provincias = await Provincia.findAll({ order: [['nombre', 'ASC']] });
  const paises = await Pais.findAll({ order: [['nombre', 'ASC']] });
  return { provincias, paises };
}

exports.listar = async (req, res) => {
  const contactos = await Contacto.findAll({
    include: incluir,
    order: [['nombre', 'ASC']],
  });
  res.render('contactos/index', { titulo: 'Contactos', contactos });
};

exports.ficha = async (req, res, next) => {
  const id = Number(req.params.id);
  if (!Number.isInteger(id)) return next();

  const contacto = await Contacto.findByPk(id, { include: incluir });
  res.render('contactos/ficha', { titulo: 'Ficha del contacto', contacto });
};

// Formulario vacío
exports.formNuevo = async (req, res) => {
  const listas = await cargarListas();
  res.render('contactos/form', {
    titulo: 'Nuevo contacto',
    accion: '/contactos/nuevo',
    ...listas,
    datos: {},
    errores: {},
  });
};

// Guardar el contacto nuevo
exports.crear = async (req, res) => {
  const errors = validationResult(req);

  if (!errors.isEmpty()) {
    const listas = await cargarListas();
    return res.status(422).render('contactos/form', {
      titulo: 'Nuevo contacto',
      accion: '/contactos/nuevo',
      ...listas,
      datos: req.body,
      errores: errors.mapped(),
    });
  }

  const { nombre, telefono, email, provinciaId, paisId } = req.body;
  const contacto = await Contacto.create({
    nombre,
    telefono,
    email,
    provinciaId: provinciaId || null,
    paisId: paisId || null,
  });
  res.redirect(`/contactos/${contacto.id}`);
};

// Formulario de edición con los datos actuales
exports.formEditar = async (req, res, next) => {
  const id = Number(req.params.id);
  if (!Number.isInteger(id)) return next();

  const contacto = await Contacto.findByPk(id);
  if (!contacto) return res.render('contactos/ficha', { titulo: 'Contacto', contacto: null });

  const listas = await cargarListas();
  res.render('contactos/form', {
    titulo: 'Modificar contacto',
    accion: `/contactos/${id}/editar`,
    ...listas,
    datos: contacto,
    errores: {},
  });
};

// Guardar los cambios
exports.actualizar = async (req, res, next) => {
  const id = Number(req.params.id);
  if (!Number.isInteger(id)) return next();

  const contacto = await Contacto.findByPk(id);
  if (!contacto) return res.render('contactos/ficha', { titulo: 'Contacto', contacto: null });

  const errors = validationResult(req);

  if (!errors.isEmpty()) {
    const listas = await cargarListas();
    return res.status(422).render('contactos/form', {
      titulo: 'Modificar contacto',
      accion: `/contactos/${id}/editar`,
      ...listas,
      datos: req.body,
      errores: errors.mapped(),
    });
  }

  const { nombre, telefono, email, provinciaId, paisId } = req.body;
  await contacto.update({
    nombre,
    telefono,
    email,
    provinciaId: provinciaId || null,
    paisId: paisId || null,
  });
  res.redirect(`/contactos/${id}`);
};

// Borrar
exports.eliminar = async (req, res, next) => {
  const id = Number(req.params.id);
  if (!Number.isInteger(id)) return next();

  await Contacto.destroy({ where: { id } });
  res.redirect('/contactos');
};