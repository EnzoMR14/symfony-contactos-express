const { Contacto, Provincia } = require('../models');

exports.listar = async (req, res) => {
  const contactos = await Contacto.findAll({
    include: { model: Provincia, as: 'provincia' },
    order: [['nombre', 'ASC']],
  });
  res.render('contactos/index', { titulo: 'Contactos', contactos });
};

exports.ficha = async (req, res, next) => {
  const id = Number(req.params.id);
  if (!Number.isInteger(id)) return next();

  const contacto = await Contacto.findByPk(id, {
    include: { model: Provincia, as: 'provincia' },
  });
  res.render('contactos/ficha', { titulo: 'Ficha del contacto', contacto });
};